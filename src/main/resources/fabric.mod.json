{
  "schemaVersion": 1,
  "id": "kizuna_inventory_ui",
  "version": "${version}",
  "name": "Kizuna's Inventory UI Framework",
  "contact": {
    "homepage": "https://github.com/Kizunad/Kizuna-Inventory-UI-Framework",
    "sources": "https://github.com/Kizunad/Kizuna-Inventory-UI-Framework",
    "issues": "https://github.com/Kizunad/Kizuna-Inventory-UI-Framework/issues"
  },
  "icon": "assets/kizuna_inventory_ui/icon.png",
  "description": "Displays inventory windows, equipment panels and HUD elements supplied by add-ons.\n在库存工作台中显示各附属提供的装备面板、窗口和状态提示。",
  "authors": ["Kizunad"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.kizuna.inventoryui.client.InventoryUiClient"]
  },
  "mixins": ["kizuna_inventory_ui.mixins.json"],
  "depends": {
    "java": ">=25",
    "kizuna_inventory_ui_server": "0.1.0",
    "minecraft": "26.2",
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.161.0+26.2",
    "owo": "0.13.1+26.2"
  }
}
